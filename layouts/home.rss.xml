{{- /* Blog feed (/feed.xml). Feed readers and tools like Zapier/Buffer can watch this. */ -}}
{{- $posts := where site.RegularPages "Section" "blog" -}}
{{- $posts = first 20 $posts.ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.Title }} — Blog</title>
    <link>{{ (site.GetPage "/blog").Permalink }}</link>
    <description>{{ (site.GetPage "/blog").Description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{- with index $posts 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $posts }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      {{- with .Params.author }}<dc:creator xmlns:dc="http://purl.org/dc/elements/1.1/">{{ . }}</dc:creator>{{ end }}
      <description>{{ .Summary | plainify }}</description>
      {{- with partial "og-image.html" . }}
      <media:content url="{{ .url }}" medium="image" width="{{ .width }}" height="{{ .height }}" />
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
